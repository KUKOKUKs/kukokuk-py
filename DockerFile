#  Base Image
FROM python:3.11-slim

#  기본 패키지 설치
RUN apt-get update && apt-get install -y \
    curl wget unzip \
    libxml2 libxslt1.1 libxslt-dev \
    chromium-driver chromium-browser \
    libglib2.0-0 libnss3 libgconf-2-4 libfontconfig1 fonts-nanum \
    && rm -rf /var/lib/apt/lists/*

#  작업 디렉토리 설정
WORKDIR /app

#  Python 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

#  애플리케이션 복사
COPY . .

#  환경변수 설정 (기본값)
ENV REDIS_HOST=redis
ENV REDIS_PORT=6379

# ============================================================
#  실행 명령
#  (아래 두 줄 중 하나 선택해서 이미지 만들기)
# ============================================================
# 그룹용 워커
# CMD ["python", "app/worker_material_group.py"]

# 관리자용 워커
CMD ["python", "app/worker_material_admin.py"]