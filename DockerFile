#  Base Image
FROM python:3.11-slim

#  작업 디렉토리 설정
WORKDIR /app

# 환경설정 (UTF-8, 로그 버퍼링 방지)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8

# lxml 등 XML 파서가 의존하는 시스템 패키지 설치
RUN apt-get update && apt-get install -y \
    curl wget unzip libxml2 libxslt1.1 libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

#  Python 의존성 설치
# requirements-prod.txt 복사
COPY requirements-prod.txt .

# 파이썬 패키지 설치 (윈도우 전용 모듈 제외)
RUN pip install --no-cache-dir -r requirements-prod.txt

#  앱 소스 코드 복사 - /app만 복사 
COPY app/ ./

# /app/downloads 디렉토리 생성 
RUN mkdir -p /app/downloads/hwp_files

# ============================================================
#  실행 명령
#  (아래 두 줄 중 하나 선택해서 이미지 만들기)
# 환경변수 REDIS_QUEUE_NAME, SPRING_CALLBACK_URL 등은
# NKS에서 ConfigMap으로 주입할 예정
# ============================================================
# -u는 버퍼링 없이 로그를 바로 출력하는 옵션 (도커 컨테이너의 stdout 로그가 실시간으로 NKS Pod Log에 표시됨)

# 관리자용 워커
CMD ["python", "-u", "worker_material_unified.py"]